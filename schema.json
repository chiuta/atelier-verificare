{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "input",
    "entry",
    "offline",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "enum": [
        "image",
        "url",
        "domain",
        "text",
        "video"
      ]
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "offline": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
