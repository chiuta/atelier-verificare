{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "id",
    "name",
    "input",
    "entry",
    "offline",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "oneOf": [
        {
          "enum": [
            "file",
            "image",
            "video",
            "url",
            "domain",
            "text"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "file",
              "image",
              "video",
              "url",
              "domain",
              "text"
            ]
          }
        }
      ]
    },
    "entry": {
      "type": "string",
      "pattern": "^checks/[a-z0-9-]+\\.js$"
    },
    "offline": {
      "type": "boolean"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
      }
    }
  },
  "additionalProperties": false
}
